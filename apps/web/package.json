{
  "name": "@synvora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @synvora/shared run build && vite",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm --filter @synvora/shared run build && pnpm run check && vite build",
    "test": "pnpm --filter @synvora/shared run build && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@synvora/shared": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "react-hook-form": "7.89.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-label": "2.1.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "24.19.1",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
